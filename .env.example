# ==============================================================================
# Snapland Environment Configuration (.env.example)
#
# Copy this file to .env and adjust values for your environment.
# NEVER commit real secret keys, credentials, or production tokens to git.
# ==============================================================================

# Application Environment ('development', 'staging', 'production')
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Backend & Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL database URL with asyncpg driver (PostGIS 16-3.4)
DATABASE_URL=postgresql+asyncpg://snapland:password@localhost:5432/snapland

# Redis URL (used for Pub/Sub, Streams, presence, caching, and rate limiting)
REDIS_URL=redis://localhost:6379/0

# Optional explicit instance ID (defaults to container hostname + random suffix)
INSTANCE_ID=

# ------------------------------------------------------------------------------
# JWT Authentication Keys (RS256)
# In development, a persistent keypair is auto-generated in the OS temp directory
# if left blank. For staging/production, provide full PEM strings.
# ------------------------------------------------------------------------------
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# Real-Time & Security Rules
# ------------------------------------------------------------------------------
# Allowed origins for WebSocket connection (comma-separated or '*' in development)
WS_ALLOWED_ORIGINS=*

# Spatial validation limits (see HLD §12.3)
MAX_AREA_KM2=1000.0
MAX_POLYGON_VERTICES=1000

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
# API base URL (use relative path /api/v1 when behind Nginx reverse proxy)
VITE_API_URL=/api/v1

# WebSocket endpoint (use relative path /ws when behind Nginx reverse proxy)
VITE_WS_URL=/ws

# Satellite imagery basemap tile URL (defaults to Esri World Imagery, see ADR-004)
VITE_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# ------------------------------------------------------------------------------
# Grafana Admin Credentials
# ------------------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
