# Database connection string
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/snapland
# Redis connection string
REDIS_URL=redis://localhost:6379/0
# JWT RS256 Private Key
JWT_PRIVATE_KEY="---BEGIN PRIVATE KEY---..."
# JWT RS256 Public Key
JWT_PUBLIC_KEY="---BEGIN PUBLIC KEY---..."
# Access token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token expiration in days
REFRESH_TOKEN_EXPIRE_DAYS=7
# CORS origins for API
CORS_ORIGINS="http://localhost:5173"
# Allowed origins for WebSocket
WS_ALLOWED_ORIGINS="http://localhost:5173"
# Instance ID for pub/sub message filtering
INSTANCE_ID=local_dev
# Maximum allowed polygon area in km2
MAX_AREA_KM2=100
# Maximum allowed polygon vertices
MAX_POLYGON_VERTICES=500
# Tile URL for satellite imagery on frontend
VITE_SATELLITE_TILE_URL="https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
VITE_USE_MOCK_API=true
